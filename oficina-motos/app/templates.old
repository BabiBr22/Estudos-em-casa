<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{% endblock %} - Oficina de Motos</title>
</head>
<body>
    <nav>
        <ul>
            <li><a href="{{ url_for('main.index') }}">Início</a></li>
            <li><a href="{{ url_for('clientes.listar_clientes') }}">Clientes</a></li>
            <li><a href="#">Motos</a></li>
            <li><a href="#">Peças</a></li>
        </ul>
    </nav>
    <main>
        {% block content %}{% endblock %}
    </main>
</body>
</html>